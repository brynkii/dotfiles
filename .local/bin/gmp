#!/USR/BIN/ENV BASH
# GMP — GIT MULTI-PROJECT MANAGER (V1.8 - PARALLEL EDITION)
# PULL UPDATES ACROSS ALL GIT REPOS, SAVE URLS FOR RECOVERY, RECOVER DELETED REPOS.
# LOGS TO ~/.LOCAL/SHARE/GMP/ — CONFIGURE VIA ROOTS ARRAY OR GMP_ROOTS ENV VAR.

SET -EUO PIPEFAIL
IFS=$'\N\T'
SHOPT -S NULLGLOB GLOBSTAR

READONLY LOG_DIR="$HOME/.LOCAL/SHARE/GMP"
READONLY LOG_FILE="$LOG_DIR/LOG.TXT"
READONLY URL_DIR="$LOG_DIR/URLS"
READONLY SCAN_FILE="$LOG_DIR/REPOS.TXT"
READONLY MAX_LOG_SIZE=$((10 * 1024 * 1024))  # 10MB
READONLY PULL_TIMEOUT=60                     # SECONDS

IFS=' ' READ -R -A ROOTS <<< "${GMP_ROOTS:-$HOME/REPOS $HOME/PROJECTS}"
READONLY ROOTS
READONLY JOBS=${JOBS:-4}

QUIET=0
TMP_FILES=()

ERR() {
  PRINTF '[%S] %S\N' "$(DATE +'%H:%M:%S')" "$*" >&2
}

LOG() {
  PRINTF '[%S] %S\N' "$(DATE +'%H:%M:%S')" "$*" | TEE -A "$LOG_FILE"
}

DIE() {
  LOG "ERROR: $*"
  EXIT 1
}

USAGE() {
  CAT <<EOF
GMP — GIT MULTI-PROJECT MANAGER
  GMP           SCAN AND UPDATE ALL REPOS
  GMP -F [DIR]  FIND REPOS, SAVE LIST
  GMP -U        UPDATE REPOS FROM SAVED LIST (AUTO-SCANS IF MISSING)
  GMP -L        BROWSE REPOS WITH FZF
  GMP -R        RECOVER DELETED REPOS
  GMP -C        CHECK REPO HEALTH
  GMP -S        SHOW LAST-UPDATE STATS
  GMP -Q CMD    RUN QUIETLY (LOG ONLY)
  GMP --CLEAN   REMOVE STALE URL FILES
  GMP -H        SHOW THIS HELP
  GMP -V        VERSION INFO

CONFIG: EDIT ROOTS ARRAY IN SCRIPT OR SET GMP_ROOTS ENV VAR
EOF
}

VERSION() {
  LOCAL NUM_LINES
  NUM_LINES=$(WC -L < "$0")
  PRINTF 'GMP V1.8 — %S LINES OF BASH\N' "$NUM_LINES"
  PRINTF 'ROOTS: %S\N' "${ROOTS[*]}"
  PRINTF 'LOGS:  %S\N' "$LOG_DIR"
  PRINTF 'JOBS:  %D PARALLEL WORKERS\N' "$JOBS"
}

CLEANUP() {
  RM -F -- "${TMP_FILES[@]:-}" 2>/DEV/NULL || TRUE
}
TRAP CLEANUP EXIT

TMPFILE() {
  LOCAL F
  F=$(MKTEMP)
  TMP_FILES+=("$F")
  PRINTF '%S\N' "$F"
}

ROTATE_LOG() {
  LOCAL SIZE=0
  IF [[ -F "$LOG_FILE" ]]; THEN
    SIZE=$(STAT -F%Z "$LOG_FILE" 2>/DEV/NULL || STAT -C%S "$LOG_FILE" 2>/DEV/NULL || PRINTF '0')
    IF (( SIZE > MAX_LOG_SIZE )); THEN
      MV "$LOG_FILE" "$LOG_FILE.OLD"
      LOG "LOG ROTATED (EXCEEDED 10MB)"
    FI
  FI
}

SCAN() {
  LOCAL DIR GITDIR
  FOR DIR IN "${@:-${ROOTS[@]}}"; DO
    [[ -D "$DIR" ]] || CONTINUE
    WHILE IFS= READ -R GITDIR; DO
      IF [[ -F "$GITDIR/CONFIG" ]] && GREP -Q '^\[REMOTE "ORIGIN"\]$' "$GITDIR/CONFIG" 2>/DEV/NULL; THEN
        PRINTF '%S\N' "${GITDIR%/.GIT}"
      FI
    DONE < <(FIND "$DIR" -NAME .GIT -TYPE D -PRUNE 2>/DEV/NULL)
  DONE
}

URL_FILE() {
  PRINTF '%S\N' "$URL_DIR/$1"
}

SAVE_URL() {
  LOCAL F URL
  F=$(URL_FILE "$1")
  [[ -F "$F" ]] && RETURN 0
  MKDIR -P "$(DIRNAME "$F")"
  IF URL=$(GIT -C "$1" REMOTE GET-URL ORIGIN 2>/DEV/NULL); THEN
    PRINTF '%S\N' "$URL" > "$F"
    RETURN 0
  FI
  RETURN 1
}

PULL_ONE() {
  LOCAL REPO=$1
  LOCAL BRANCH
  BRANCH=$(GIT -C "$REPO" BRANCH --SHOW-CURRENT 2>/DEV/NULL || TRUE)
  [[ -Z "$BRANCH" ]] && BRANCH="(DETACHED HEAD)"
  
  IF TIMEOUT "$PULL_TIMEOUT" GIT -C "$REPO" PULL --FF-ONLY >> "$LOG_FILE" 2>&1; THEN
    PRINTF '[%S]   OK  %S (%S)\N' "$(DATE +'%H:%M:%S')" "$REPO" "$BRANCH" | TEE -A "$LOG_FILE"
    SAVE_URL "$REPO" || TRUE
    RETURN 0
  ELSE
    PRINTF '[%S] FAIL  %S (%S)\N' "$(DATE +'%H:%M:%S')" "$REPO" "$BRANCH" | TEE -A "$LOG_FILE"
    RETURN 1
  FI
}
EXPORT -F PULL_ONE SAVE_URL URL_FILE
EXPORT LOG_FILE URL_DIR PULL_TIMEOUT

CMD_FIND() {
  LOG "SCANNING..."
  LOCAL TMP COUNT
  TMP=$(TMPFILE)
  SCAN "$@" > "$TMP"
  COUNT=$(WC -L < "$TMP")
  
  IF (( COUNT == 0 )); THEN
    LOG "NO REPOS FOUND"
    RETURN 0
  FI
  
  MV "$TMP" "$SCAN_FILE"
  LOG "FOUND $COUNT REPOS"
  CAT -N "$SCAN_FILE" | HEAD -50
  IF (( COUNT > 50 )); THEN
    PRINTF '... AND %D MORE\N' "$(( COUNT - 50 ))"
  FI
}

CMD_UPDATE() {
  IF [[ ! -S "$SCAN_FILE" ]]; THEN
    LOG "NO SAVED REPOS — SCANNING ROOTS AUTOMATICALLY..."
    CMD_FIND
  FI
  [[ -S "$SCAN_FILE" ]] || DIE "NO REPOS FOUND TO UPDATE"
  
  LOCAL TOTAL OK=0 FAIL=0 RESULTS REPO
  TOTAL=$(WC -L < "$SCAN_FILE")
  
  LOG "UPDATING $TOTAL REPOS (${JOBS} PARALLEL JOBS)"
  
  IF (( TOTAL < 3 )); THEN
    WHILE IFS= READ -R REPO; DO
      IF PULL_ONE "$REPO"; THEN
        (( OK++ ))
      ELSE
        (( FAIL++ ))
      FI
    DONE < "$SCAN_FILE"
    LOG "DONE: $OK OK, $FAIL FAILED (OF $TOTAL)"
  ELSE
    RESULTS=$(TMPFILE)
    
    XARGS -P"$JOBS" -I{} BASH -C '
      IF PULL_ONE "{}"; THEN PRINTF "OK\N" >&3; ELSE PRINTF "FAIL\N" >&3; FI
    ' _ {} < "$SCAN_FILE" 3> "$RESULTS"
    
    OK=$(GREP -C '^OK$' "$RESULTS" 2>/DEV/NULL || TRUE)
    FAIL=$(GREP -C '^FAIL$' "$RESULTS" 2>/DEV/NULL || TRUE)
    
    LOG "DONE: $OK OK, $FAIL FAILED (OF $TOTAL)"
  FI
}

CMD_LIST() {
  COMMAND -V FZF >/DEV/NULL || DIE "FZF REQUIRED"
  SCAN "$@" | FZF --PREVIEW 'EZA -L --COLOR=ALWAYS {}' --PREVIEW-WINDOW=RIGHT:60%
}

CMD_RECOVER() {
  COMMAND -V FZF >/DEV/NULL || DIE "FZF REQUIRED"
  [[ -D "$URL_DIR" ]] || DIE "NO SAVED URLS — RUN GMP -F FIRST"
  
  LOCAL -A MISSING=()
  LOCAL F DIR SELECTED REPO URL RECOVERED=0 FAILED=0
  WHILE IFS= READ -R F; DO
    DIR="${F#"$URL_DIR"}"
    [[ -D "$DIR" ]] || MISSING+=("$DIR")
  DONE < <(FIND "$URL_DIR" -TYPE F 2>/DEV/NULL)
  
  (( ${#MISSING[@]} )) || { LOG "NOTHING TO RECOVER"; RETURN 0; }
  
  SELECTED=$(PRINTF '%S\N' "${MISSING[@]}" | FZF -M --PROMPT='RECOVER> ')
  [[ -N "$SELECTED" ]] || { LOG "CANCELLED"; RETURN 0; }
  
  WHILE IFS= READ -R REPO; DO
    [[ -Z "$REPO" ]] && CONTINUE
    URL=$(< "$(URL_FILE "$REPO")")
    LOG "CLONE $URL -> $REPO"
    MKDIR -P "$(DIRNAME "$REPO")"
    IF GIT CLONE "$URL" "$REPO" >> "$LOG_FILE" 2>&1; THEN
      LOG "  OK  $REPO"
      (( RECOVERED++ ))
    ELSE
      LOG "FAIL  $REPO"
      (( FAILED++ ))
    FI
  DONE <<< "$SELECTED"
  
  LOG "RECOVERED: $RECOVERED OK, $FAILED FAILED"
}

CMD_CHECK() {
  LOCAL REPO
  [[ -F "$SCAN_FILE" ]] || DIE "NO SAVED REPOS — RUN: GMP -F"
  WHILE IFS= READ -R REPO; DO
    LOG "CHECK $REPO"
    GIT -C "$REPO" STATUS --SHORT 2>&1 | HEAD -5
    PRINTF -- '---\N'
  DONE < "$SCAN_FILE"
}

CMD_STATS() {
  [[ -D "$URL_DIR" ]] || { LOG "NO SAVED REPOS"; RETURN 0; }
  
  LOCAL F DIR LAST COUNT=0
  WHILE IFS= READ -R F; DO
    DIR="${F#"$URL_DIR"}"
    LAST=$(CD "$DIR" 2>/DEV/NULL && GIT LOG -1 --FORMAT="%AR" 2>/DEV/NULL || PRINTF 'MISSING')
    PRINTF '%-60S %S\N' "$DIR" "$LAST"
    (( COUNT++ ))
  DONE < <(FIND "$URL_DIR" -TYPE F 2>/DEV/NULL)
  
  (( COUNT )) || LOG "NO REPOS FOUND"
}

CMD_CLEAN_URLS() {
  [[ -D "$URL_DIR" ]] || RETURN 0
  LOCAL CLEANED=0 F DIR
  WHILE IFS= READ -R F; DO
    DIR="${F#"$URL_DIR"}"
    IF [[ ! -D "$DIR" ]]; THEN
      RM -F -- "$F"
      (( CLEANED++ ))
    FI
  DONE < <(FIND "$URL_DIR" -TYPE F 2>/DEV/NULL)
  (( CLEANED )) && LOG "CLEANED $CLEANED STALE URLS"
}

MAIN() {
  LOCAL ARG ARGS=()
  
  MKDIR -P "$LOG_DIR" "$URL_DIR"
  
  FOR ARG IN "$@"; DO
    IF [[ "$ARG" == "-Q" ]]; THEN
      QUIET=1
    ELSE
      ARGS+=("$ARG")
    FI
  DONE
  SET -- "${ARGS[@]:-}"
  
  IF (( QUIET )); THEN
    EXEC 1>/DEV/NULL
  FI
  
  ROTATE_LOG
  
  CASE "${1:-}" IN
    -F) SHIFT; CMD_FIND "$@" ;;
    -U) CMD_UPDATE ;;
    -L) SHIFT; CMD_LIST "$@" ;;
    -R) CMD_RECOVER ;;
    -C) CMD_CHECK ;;
    -S) CMD_STATS ;;
    --CLEAN) CMD_CLEAN_URLS ;;
    -H|--HELP) USAGE ;;
    -V|--VERSION) VERSION ;;
    '')
      CMD_FIND "$@"
      CMD_UPDATE
      ;;
    *) DIE "UNKNOWN: $1 — TRY: GMP -H" ;;
  ESAC
  
  EXIT 0
}

Main "$@"

