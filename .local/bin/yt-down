#!/usr/bin/env bash

set -euo pipefail

# Configuration
readonly LOGFILE="$HOME/.local/share/download-media/download.log"
readonly HISTORY_FILE="$HOME/.local/share/download-media/download_history.tsv"
readonly COOKIE_ARGS="--cookies-from-browser chrome"
VIDEO_QUALITY="720"
NO_PLAYLIST=false
BATCH_FILE=""
CHANNEL_MODE=false
OUTPUT_DIR=""

# Colors
readonly RED=$'\033[1;31m'
readonly GRN=$'\033[1;32m'
readonly YEL=$'\033[1;33m'
readonly BLU=$'\033[1;34m'
readonly CYN=$'\033[1;36m'
readonly NC=$'\033[0m'

# Common yt-dlp args
readonly COMMON_ARGS=(--restrict-filenames --progress --no-warnings)

print_help() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] <url...>

Download media using yt-dlp with smart fallbacks.

OPTIONS:
  --help                    Show this help
  --history                 Show download history
  --video-quality QUALITY   Set video quality (default: 720)
  --no-playlist             Download single video only
  --output-dir DIR          Specify output directory
  --batch-file FILE         Download URLs from file
  --channel                 Download entire channel

EXAMPLES:
  $(basename "$0") <url>
  $(basename "$0") --history
  $(basename "$0") --batch-file ~/urls.txt
  $(basename "$0") --channel <channel-url>
EOF
}

draw_table() {
    local -a headers=("$@")
    local -a col_widths=()
    local -a rows=()
    
    # Calculate column widths based on headers
    local i
    for i in "${!headers[@]}"; do
        col_widths[i]=${#headers[$i]}
    done
    
    # Read data from history file (skip header)
    local line_num=0
    while IFS=$'\t' read -r timestamp title url _ type; do
        [[ $line_num -eq 0 ]] && { line_num=1; continue; }  # Skip header
        
        # Store as array
        local -a fields=("$timestamp" "$title" "$url" "$type")
        rows+=("$(printf '%s\t%s\t%s\t%s' "$timestamp" "$title" "$url" "$type")")
        
        # Update column widths
        for i in "${!fields[@]}"; do
            [[ $i -ge ${#col_widths[@]} ]] && break
            local field_len=${#fields[$i]}
            [[ $field_len -gt ${col_widths[i]} ]] && col_widths[i]=$field_len
        done
    done < "$HISTORY_FILE"
    
    # Add padding to column widths
    for i in "${!col_widths[@]}"; do
        col_widths[i]=$((col_widths[i] + 3))
    done
    
    # Create line separator parts
    local -a line_parts=()
    local width
    for width in "${col_widths[@]}"; do
        local line=""
        local _
        for _ in $(seq 1 "$width"); do line+="─"; done
        line_parts+=("$line")
    done
    
    # Print top border
    printf '%s' "${BLU}┌"
    for i in "${!line_parts[@]}"; do
        printf '%s' "${line_parts[$i]}"
        [[ $i -lt $((${#line_parts[@]}-1)) ]] && printf '%s' "┬"
    done
    printf '┐%s\n' "${NC}"
    
    # Print headers
    printf '%s' "${BLU}│${NC}"
    for i in "${!headers[@]}"; do
        local header="${headers[$i]}"
        local padding=$((col_widths[i] - ${#header}))
        local left_pad=$((padding / 2))
        local right_pad=$((padding - left_pad))
        printf '%s' "${CYN}"
        printf '%*s%s%*s' "$left_pad" "" "$header" "$right_pad" ""
        printf '%s' "${NC}${BLU}│${NC}"
    done
    printf '\n'
    
    # Print separator
    printf '%s' "${BLU}├"
    for i in "${!line_parts[@]}"; do
        printf '%s' "${line_parts[$i]}"
        [[ $i -lt $((${#line_parts[@]}-1)) ]] && printf '%s' "┼"
    done
    printf '┤%s\n' "${NC}"
    
    # Print data rows
    local row
    for row in "${rows[@]}"; do
        IFS=$'\t' read -r timestamp title url type <<< "$row"
        
        # Format fields
        local display_date="${timestamp:0:16}"
        local display_title="$title"
        local display_url="$url"
        
        # Truncate long fields
        if [[ ${#display_title} -gt $((col_widths[1]-2)) ]]; then
            display_title="${display_title:0:$((col_widths[1]-3))}…"
        fi
        if [[ ${#display_url} -gt $((col_widths[2]-2)) ]]; then
            display_url="${display_url:0:$((col_widths[2]-3))}…"
        fi
        
        # Color type
        local display_type="$type"
        case "$type" in
            "🎬") display_type="${GRN}Video${NC}" ;;
            "🎵") display_type="${YEL}Audio${NC}" ;;
            "📝") display_type="${CYN}Subs${NC}" ;;
            "channel") display_type="${BLU}Channel${NC}" ;;
        esac
        
        # Print row
        printf '%s' "${BLU}│${NC}"
        
        # Date
        printf ' %-*s %s' "$((col_widths[0]-2))" "$display_date" "${BLU}│${NC}"
        
        # Title
        printf ' %-*s %s' "$((col_widths[1]-2))" "$display_title" "${BLU}│${NC}"
        
        # URL
        printf ' %-*s %s' "$((col_widths[2]-2))" "$display_url" "${BLU}│${NC}"
        
        # Type (with color)
        printf ' %-*s %s' "$((col_widths[3]-2))" "$display_type" "${BLU}│${NC}"
        
        # Status
        printf ' %s  %s' "${GRN}✓${NC}" "${BLU}│${NC}"
        
        printf '\n'
    done
    
    # Print bottom border
    printf '%s' "${BLU}└"
    for i in "${!line_parts[@]}"; do
        printf '%s' "${line_parts[$i]}"
        [[ $i -lt $((${#line_parts[@]}-1)) ]] && printf '%s' "┴"
    done
    printf '┘%s\n' "${NC}"
}

show_history() {
    [[ ! -f "$HISTORY_FILE" ]] && { echo "${YEL}No history found${NC}"; return 0; }
    [[ $(wc -l < "$HISTORY_FILE") -le 1 ]] && { echo "${YEL}History is empty${NC}"; return 0; }
    
    echo -e "\n${CYN}  📥 Download History${NC}\n"
    draw_table "Date" "Title" "URL" "Type" "✓"
    
    local total=$(( $(wc -l < "$HISTORY_FILE") - 1 ))
    echo -e "\n${CYN}  📊 Total: ${GRN}$total downloads${NC}"
    echo -e "${BLU}  📁 $HISTORY_FILE${NC}\n"
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help) print_help; exit 0 ;;
        --history) show_history; exit 0 ;;
        --video-quality) VIDEO_QUALITY="${2:?}"; shift 2 ;;
        --no-playlist) NO_PLAYLIST=true; shift ;;
        --output-dir) OUTPUT_DIR="${2:?}"; shift 2 ;;
        --batch-file) BATCH_FILE="${2:?}"; shift 2 ;;
        --channel) CHANNEL_MODE=true; shift ;;
        *) break ;;
    esac
done

[[ $# -eq 0 && -z "$BATCH_FILE" ]] && { print_help; exit 0; }

# Check dependencies
for cmd in yt-dlp fzf; do
    command -v "$cmd" &>/dev/null || { echo "${RED}$cmd required${NC}"; exit 1; }
done

# Setup
mkdir -p "$(dirname "$LOGFILE")"
[[ -f "$LOGFILE" && $(stat -f%z "$LOGFILE" 2>/dev/null || stat -c%s "$LOGFILE") -gt 10485760 ]] && mv "$LOGFILE" "$LOGFILE.old"

log() { echo "$(date '+%F %T') [$1] $2" >> "$LOGFILE"; }

record_history() {
    [[ ! -f "$HISTORY_FILE" ]] && printf "Timestamp\tTitle\tURL\tFile Path\tType\n" > "$HISTORY_FILE"
    printf "%s\t%s\t%s\t%s\t%s\n" "$(date '+%F %T')" "$2" "$1" "$3" "$4" >> "$HISTORY_FILE"
}

# User interaction functions
select_output_dir() {
    [[ -n "$OUTPUT_DIR" ]] && { mkdir -p "$OUTPUT_DIR"; echo "$OUTPUT_DIR"; return; }
    
    local yt_dir="$HOME/Videos/youtube"
    mkdir -p "$yt_dir"
    
    local -a dirs=("Create new directory" "Videos root" "Music")
    local dir
    while IFS= read -r dir; do
        [[ -n "$dir" ]] && dirs+=("$dir")
    done < <(find "$yt_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
    
    local selected
    selected=$(printf "%s\n" "${dirs[@]}" | fzf --prompt="Output directory: ")
    
    case "$selected" in
        "Create new directory")
            local name
            read -rp "Directory name: " name
            name="${name//[^a-zA-Z0-9_-]/_}"
            mkdir -p "$yt_dir/$name"
            echo "$yt_dir/$name"
            ;;
        "Videos root") echo "$yt_dir" ;;
        "Music") echo "$HOME/Music" ;;
        *) echo "$selected" ;;
    esac
}

select_type() {
    printf "%s\n" \
        "🎬 Video (${VIDEO_QUALITY}p)" \
        "🎵 Audio" \
        "📝 Video with subtitles" | \
        fzf --prompt="Download type: " | cut -d' ' -f1
}

get_format_args() {
    local type="$1"
    local -n args_ref=$2
    
    case "$type" in
        "🎬")
            args_ref=(-f "bestvideo[height<=${VIDEO_QUALITY}][ext=webm]+bestaudio[ext=webm]/best[height<=${VIDEO_QUALITY}][ext=webm]" --merge-output-format webm)
            ;;
        "🎵")
            local fmt
            fmt=$(printf "mp3\nopus\nflac" | fzf --prompt="Audio format: ")
            args_ref=(-f "bestaudio/best" --extract-audio --audio-format "$fmt" --embed-thumbnail --add-metadata)
            ;;
        "📝")
            local lang
            lang=$(printf "en\nes\nde\nfr\nja\nko\nzh-CN" | fzf --prompt="Subtitle language: ")
            args_ref=(-f "bestvideo[height<=${VIDEO_QUALITY}][ext=webm]+bestaudio[ext=webm]/best[height<=${VIDEO_QUALITY}][ext=webm]" --merge-output-format webm --write-subs --write-auto-subs --embed-subs --sub-langs "$lang" --sub-format "srt/best")
            ;;
    esac
}

# Download functions
download() {
    local url="$1" dir="$2" type="$3"
    local -a format_args
    get_format_args "$type" format_args
    
    local title
    title=$(yt-dlp --print "%(title)s" --skip-download "$url" 2>/dev/null || echo "Unknown")
    echo "${BLU}Title: $title${NC}"
    
    local -a clients=(
        "android --extractor-args youtube:player_client=android $COOKIE_ARGS"
        "web --extractor-args youtube:player_client=web"
        "default "
    )
    
    local client
    for client in "${clients[@]}"; do
        local -a parts
        read -ra parts <<< "$client"
        local name="${parts[0]}"
        local -a yt_args=("${COMMON_ARGS[@]}" "${format_args[@]}")
        
        [[ ${#parts[@]} -gt 1 ]] && yt_args+=("${parts[@]:1}")
        [[ "$NO_PLAYLIST" == true ]] && yt_args+=(--no-playlist)
        yt_args+=(-o "$dir/%(title)s.%(ext)s" "$url")
        
        [[ "$name" != "default" ]] && echo "${YEL}Client: $name${NC}"
        
        if yt-dlp "${yt_args[@]}" 2>/dev/null; then
            record_history "$url" "$title" "$dir" "$type"
            return 0
        fi
    done
    return 1
}

download_channel() {
    local url="$1" dir="$2" type="$3"
    local -a format_args
    get_format_args "$type" format_args
    
    local name
    name=$(yt-dlp --print "%(channel)s" --playlist-items 1 "$url" 2>/dev/null | sed 's/[^a-zA-Z0-9_-]/_/g')
    name="${name:-channel_$(date +%Y%m%d)}"
    mkdir -p "$dir/$name"
    
    local -a yt_args=("${COMMON_ARGS[@]}" "${format_args[@]}")
    local -a cookie_args
    read -ra cookie_args <<< "$COOKIE_ARGS"
    yt_args+=(--download-archive "$dir/$name/.archive" --match-filter "!is_live" "${cookie_args[@]}")
    yt_args+=(-o "$dir/$name/%(upload_date)s_%(title)s.%(ext)s" "$url")
    
    yt-dlp "${yt_args[@]}" && record_history "$url" "Channel: $name" "$dir/$name" "channel"
}

batch_download() {
    local file="$1" dir="$2" type="$3"
    [[ ! -f "$file" ]] && { echo "${RED}File not found: $file${NC}"; return 1; }
    
    local -a format_args
    get_format_args "$type" format_args
    
    local -a yt_args=("${COMMON_ARGS[@]}" "${format_args[@]}")
    local -a cookie_args
    read -ra cookie_args <<< "$COOKIE_ARGS"
    yt_args+=(--batch-file "$file" --download-archive "$dir/.archive" --parallel-downloads 3 "${cookie_args[@]}")
    [[ "$NO_PLAYLIST" == true ]] && yt_args+=(--no-playlist)
    yt_args+=(-o "$dir/%(playlist_title)s/%(title)s.%(ext)s")
    
    yt-dlp "${yt_args[@]}" || return 1
    
    local url
    while IFS= read -r url; do
        [[ "$url" =~ ^https?:// ]] && record_history "$url" "Batch" "$dir" "$type"
    done < "$file"
}

# Main
main() {
    local dir type
    dir=$(select_output_dir)
    type=$(select_type)
    [[ -z "$type" ]] && { echo "${RED}No type selected${NC}"; exit 1; }
    
    trap 'echo -e "\n${YEL}Interrupted${NC}"; exit 1' INT TERM
    
    if [[ -n "$BATCH_FILE" ]]; then
        batch_download "$BATCH_FILE" "$dir" "$type" && echo "${GRN}✓ Complete${NC}" || echo "${RED}✗ Failed${NC}"
        return
    fi
    
    if [[ "$CHANNEL_MODE" == true ]]; then
        download_channel "$1" "$dir" "$type" && echo "${GRN}✓ Complete${NC}" || echo "${RED}✗ Failed${NC}"
        return
    fi
    
    local url
    for url in "$@"; do
        [[ "$url" =~ ^https?:// ]] || { echo "${RED}Invalid URL: $url${NC}"; continue; }
        
        log "INFO" "Downloading: $url"
        if download "$url" "$dir" "$type"; then
            log "SUCCESS" "Downloaded: $url"
            echo "${GRN}✓ $url${NC}"
        else
            log "ERROR" "Failed: $url"
            echo "${RED}✗ $url${NC}"
            echo "${YEL}Update: pip install --upgrade yt-dlp${NC}"
        fi
    done
}

main "$@"
